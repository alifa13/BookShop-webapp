						</div>
						<div class="dz-content">
							<h4 class="title">Adventure</h4>
							<span class="price">$18,78</span>
							<a @onclick="(() => AddToCart(5))" class="btn btn-secondary btnhover btnhover2"><i class="flaticon-shopping-cart-1 m-r10"></i> افزودن به سبد خرید</a>
						</div>
					</div>
				</div>
