@code {

	protected async override Task OnInitializedAsync()
	{
		await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./vendor/swiper/swiper-bundle.min.js");
		var _jsModule = await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/dz.carousel.js");
		await _jsModule.InvokeVoidAsync("carouselLoad");
	}

	private void AddToCart(int bookId)
	{
		shopCartService.AddToCart(bookId);
	}
}
