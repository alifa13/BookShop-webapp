@using BookShop.Utility;
@inherits LayoutComponentBase

@inject UserLoginStateContainer UserLoginStateContainer
@inject CookieHelper CookieHelper;


<!--Header-->
<Header />

<!--Page Content-->
@Body

<!--Footer-->
<Footer />

<button class="scroltop" type="button"><i class="fas fa-arrow-up"></i></button>

@code {
    protected override async Task OnInitializedAsync()
    {
        var token = await CookieHelper.GetCookie("WebToken");
        var userId = await CookieHelper.GetCookie("User");
        var session = await CookieHelper.GetCookie("Session");

        if (string.IsNullOrWhiteSpace(token))
            UserLoginStateContainer.SetValue(false);
        else
            UserLoginStateContainer.SetValue(true, token, session, int.Parse(userId), true);
    }
}
