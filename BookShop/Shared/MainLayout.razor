@using BookShop.Services;
@using BookShop.Utility;
@inherits LayoutComponentBase

@inject UserLoginStateContainer UserLoginStateContainer
@inject CookieHelper CookieHelper;


<!--Header-->
<Header />

<!--Page Content-->
@Body

<!--Footer-->
<Footer />

<button class="scroltop" type="button"><i class="fas fa-arrow-up"></i></button>

@code {
    protected override async Task OnInitializedAsync()
    {
        var token = await CookieHelper.GetCookie("WebToken");
        var userIdStr = await CookieHelper.GetCookie("User");
        var session = await CookieHelper.GetCookie("Session");

        if (string.IsNullOrWhiteSpace(token))
        {
            UserLoginStateContainer.SetValue(false);
        }
        else
        {
            if (int.TryParse(userIdStr, out int userId))
            {
                var customerGetResponse = await ApiCallService.CustomerApi.ApiCustomerGetPostAsync(new ApiCaller.Model.ApiRequest
                    {
                        Id = userId
                    });

                if (!(customerGetResponse?.IsSuccess ?? false))
                    return;

                UserLoginStateContainer.SetValue(true, token, session, userId, customerGetResponse.ResponseDTO, notify: true);
            }
        }
    }
}
