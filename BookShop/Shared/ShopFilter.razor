@code {
    private async Task FilterButtonClick()
    {
        var _jsModule = await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./Shared/ShopFilter.razor.js");
        var result = await _jsModule.InvokeAsync<List<string>>("getSliderValue");
        var filter = new Models.ShopFilterModel
            {
                CategoryIds = new List<int>(),
                PublisherId = new List<int>()
            };

        if (double.TryParse(result[0], out double fromPrice))
            filter.FromPrice = fromPrice;
        if (double.TryParse(result[1], out double toPrice))
            filter.ToPrice = toPrice;

        shopFilterStateContainer.SetValue(filter);
    }
}
