        </div>
    </div>
    <!-- Main Header End -->

</header>
<!-- Header End -->
@code {
    private CustomerDTO customer = new CustomerDTO();
    private string fullName = "",mobile = "";
    private int shopCartItemCount = 0;

    protected override async Task OnInitializedAsync()
    {
        UserLoginStateContainer.OnStateChange += UserLoginStatusChanged;
        ShopCartService.OnCartChange += ShopCartChanged;

        shopCartItemCount = (await ShopCartService.GetCartItems())?.Values?.Sum() ?? 0;

    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./vendor/bootstrap-select/dist/js/bootstrap-select.min.js");
    }

    private async void UserLoginStatusChanged()
    {
        if (UserLoginStateContainer.IsLogin)
        {
            customer = UserLoginStateContainer.Customer;
            if (customer is null)
                return;

            fullName = $"{customer.FirstName} {customer.LastName}";
            mobile = customer.Mobile;
        }

        StateHasChanged();
    }

    private async void ShopCartChanged()
    {
        shopCartItemCount = (await ShopCartService.GetCartItems())?.Values?.Sum() ?? 0;
        
        if (shopCartItemCount > 0)
            await ToastHelper.Notify("کتاب مورد نظر به سبد خرید اضافه شد", ToastType.Success);

        StateHasChanged();
    }

    private async Task Logout()
    {
        var session = await CookieHelper.GetCookie("Session");
        if (string.IsNullOrWhiteSpace(session))
            return;

        var response = await ApiCallService.UserApi.ApiUserLogoutPostAsync(new ApiCaller.Model.LogoutRequestDTOApiRequest
            {
                RequestDTO = new ApiCaller.Model.LogoutRequestDTO
                {
                    SessionIdentifier = session
                }
            });

        if (response?.IsSuccess ?? false)
        {
            await CookieHelper.DeleteCookie("WebToken");
            await CookieHelper.DeleteCookie("User");
            await CookieHelper.DeleteCookie("Session");

            UserLoginStateContainer.SetValue(isLogin: false);
            await ToastHelper.Notify("خروج از حساب کاربری با موفقیت انجام شد", ToastType.Success);

            navManager.NavigateTo("/", false);
        }
        else
            await ToastHelper.Notify(response?.Message ?? "خروج از حساب کاربری با خطا مواجه شد", ToastType.Error);

    }

    public void Dispose()
    {
        UserLoginStateContainer.OnStateChange -= UserLoginStatusChanged;
        ShopCartService.OnCartChange -= ShopCartChanged;
    }
}
