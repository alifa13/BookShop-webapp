                        <UnorderedListItem><a href="/"><span>درباره ما</span></a></UnorderedListItem>
                        <UnorderedListItem><a href="/book/list"><span>فروشگاه</span></a></UnorderedListItem>
                        <UnorderedListItem><a href="/"><span>ارتباط با ما</span></a></UnorderedListItem>
                    </UnorderedList>
                    <div class="dz-social-icon">
