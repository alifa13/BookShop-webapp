@page "/ShopCart"
@using BookShop.ApiCaller.Api;
@using BookShop.ApiCaller.Model;
@using BookShop.Services;
@using BookShop.Shared.Models;
@using BookShop.Utility;

@inject ShopCartService ShopCartService;

@implements IDisposable;

<div class="page-content">
	<!-- inner page banner -->
	<Banner Title="سبد خرید" PrePageTitle="خانه" PrePageRoute="/" />
	<!-- inner page banner End-->
	<!-- contact area -->
	<section class="content-inner shop-account">
		<!-- Product -->
		<div class="container">
			<div class="row mb-5">
				<div class="col-lg-12">
					<div class="table-responsive">
						<table class="table check-tbl">
							<thead>
								<tr>
									<th>تصویر</th>
									<th>عنوان</th>
									<th>مبلغ</th>
									<th>تعداد</th>
									<th>جمع</th>
									<th class="text-end">Close</th>
								</tr>
							</thead>
							<tbody>
								@foreach (var item in shopCartItems)
								{
									<tr>
										<td class="product-item-img"><img src="images/books/large/bigbook1.jpg" alt=""></td>
										<td class="product-item-name">@(item.BookTitle)</td>
										<td class="product-item-price">@(item.BookPrice.ToPriceFormat()) ریال</td>
										<td class="product-item-quantity">
											<div class="quantity btn-quantity style-1 me-3">
												<NumericPicker @bind-Value="@(item.Count)" Min="0" Max="100" />
											</div>
										</td>
										<td class="product-item-totle">@(item.BookTotalPrice.ToPriceFormat()) ریال</td>
										<td class="product-item-close"><a class="ti-close"></a></td>
									</tr>
								}								
							</tbody>
						</table>
					</div>
				</div>

			</div>
			<div class="row">
				<div class="col-lg-12">
					<div class="widget">
						<h4 class="widget-title">جمع سبد خرید</h4>
						<table class="table-bordered check-tbl m-b25">
							<tbody>
								<tr>
									<td>جمع مبلغ سفارش</td>
									<td>@(cartTotalPrice.ToPriceFormat()) ریال</td>
								</tr>
								<tr>
									<td>هزینه ارسال</td>
									<td>بعد از ارسال مشخص می شود</td>
								</tr>
								<tr>
									<td>جمع کل</td>
									<td>@(cartTotalPrice.ToPriceFormat()) ریال</td>
								</tr>
							</tbody>
						</table>
						<div class="form-group m-b25">
							<a href="/Checkout" class="btn btn-primary btnhover" type="button">تایید نهایی</a>
						</div>
					</div>
				</div>
			</div>
		</div>
		<!-- Product END -->
	</section>
	<!-- contact area End-->

</div>

@code {
	List<BookDTO> books = new List<BookDTO>();
	private List<ShopCartItemModel> shopCartItems = new List<ShopCartItemModel>();
	decimal cartTotalPrice = 0;

	protected override async Task OnParametersSetAsync()
	{
		await LoadCart();

		await base.OnParametersSetAsync();
	}

	private async Task LoadCart()
	{
		var cartItems = await ShopCartService.GetCartItems();
		var bookIds = cartItems.Keys?.ToList() ?? new List<int>();

		if (!bookIds.Any())
			return;

		var bookReportResponse = await ApiCallService.BookApi.ApiBookReportPostAsync(new BookReportFilterDTOApiRequest
			{
				RequestDTO = new BookReportFilterDTO
				{
					BookIDs = bookIds
				}
			});

		if (!bookReportResponse?.IsSuccess ?? true)
			return;

		books = bookReportResponse!.ResponseDTO.ResultList;

		shopCartItems = books?.Select(book => new ShopCartItemModel
		{
			BookID = book.Id,
			Count = cartItems.GetValueOrDefault(book.Id),
			BookPrice = (decimal)book.Price,
			BookTitle = book.Title
		})?.ToList() ?? new List<ShopCartItemModel>();

		cartTotalPrice = shopCartItems.Sum(x => x.BookTotalPrice);
	}

	public void Dispose()
	{
		var cartItems = shopCartItems?.ToDictionary(x => x.BookID, x => x.Count);
		if (cartItems is null)
			return;	

		ShopCartService.SetCartItems(cartItems);
	}
}
