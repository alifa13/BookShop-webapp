@page "/ShopCart"
@using BookShop.ApiCaller.Api;
@using BookShop.ApiCaller.Model;
@using BookShop.Services;
@using BookShop.Shared.Models;

@inject ShopCartService ShopCartService;

<div class="page-content">
	<!-- inner page banner -->
	<Banner Title="سبد خرید" PrePageTitle="خانه" PrePageRoute="/" />
	<!-- inner page banner End-->
	<!-- contact area -->
	<section class="content-inner shop-account">
		<!-- Product -->
		<div class="container">
			<div class="row mb-5">
				<div class="col-lg-12">
					<div class="table-responsive">
						<table class="table check-tbl">
							<thead>
								<tr>
									<th>تصویر</th>
									<th>عنوان</th>
									<th>مبلغ</th>
									<th>تعداد</th>
									<th>جمع</th>
									<th class="text-end">Close</th>
								</tr>
							</thead>
							<tbody>
								@foreach (var item in shopCartItems)
								{
									<tr>
										<td class="product-item-img"><img src="images/books/large/bigbook1.jpg" alt=""></td>
										<td class="product-item-name">@(item.BookTitle)</td>
										<td class="product-item-price">@(item.BookPrice) ریال</td>
										<td class="product-item-quantity">
											<div class="quantity btn-quantity style-1 me-3">
												<NumericPicker @bind-Value="@(item.Count)" Min="0" Max="100" />
											</div>
										</td>
										<td class="product-item-totle">@(item.BookTotalPrice)</td>
										<td class="product-item-close"><a class="ti-close"></a></td>
									</tr>
								}								
							</tbody>
						</table>
					</div>
				</div>

			</div>
			<div class="row">
				<div class="col-lg-6">
					<div class="widget">
						<form class="shop-form">
							<h4 class="widget-title">Calculate Shipping</h4>
							<div class="form-group">
								<select class="default-select">
									<option selected>Credit Card Type</option>
									<option value="1">Another option</option>
									<option value="2">A option</option>
									<option value="3">Potato</option>
								</select>
							</div>
							<div class="row">
								<div class="form-group col-lg-6">
									<input type="text" class="form-control" placeholder="Credit Card Number">
								</div>
								<div class="form-group col-lg-6">
									<input type="text" class="form-control" placeholder="Card Verification Number">
								</div>
							</div>
							<div class="form-group">
								<input type="text" class="form-control" placeholder="Coupon Code">
							</div>
							<div class="form-group">
								<a href="/ShopCart" class="btn btn-primary btnhover" type="button">Apply Coupon</a>
							</div>
						</form>
					</div>
				</div>
				<div class="col-lg-6">
					<div class="widget">
						<h4 class="widget-title">Cart Subtotal</h4>
						<table class="table-bordered check-tbl m-b25">
							<tbody>
								<tr>
									<td>Order Subtotal</td>
									<td>$125.96</td>
								</tr>
								<tr>
									<td>Shipping</td>
									<td>Free Shipping</td>
								</tr>
								<tr>
									<td>Coupon</td>
									<td>$28.00</td>
								</tr>
								<tr>
									<td>Total</td>
									<td>$506.00</td>
								</tr>
							</tbody>
						</table>
						<div class="form-group m-b25">
							<a href="/Checkout" class="btn btn-primary btnhover" type="button">تایید نهایی</a>
						</div>
					</div>
				</div>
			</div>
		</div>
		<!-- Product END -->
	</section>
	<!-- contact area End-->

</div>

@code {
	private int a = 1;
	List<BookDTO> books = new List<BookDTO>();
	private List<ShopCartItemModel> shopCartItems = new List<ShopCartItemModel>();

	protected override Task OnInitializedAsync()
	{
		return base.OnInitializedAsync();
	}
	private async void LoadCart()
	{
		var cartItems = await ShopCartService.GetCartItems();
		var bookIds = cartItems.Keys?.ToList() ?? new List<int>();

		var bookReportResponse = await ApiCallService.BookApi.ApiBookReportPostAsync(new BookReportFilterDTOApiRequest
			{
				RequestDTO = new BookReportFilterDTO
				{
					BookIDs = bookIds
				}
			});

		if (!bookReportResponse?.IsSuccess ?? true)
			return;

		books = bookReportResponse!.ResponseDTO.ResultList;

		shopCartItems = books?.Select(book => new ShopCartItemModel
		{
			BookID = book.Id,
			Count = cartItems.GetValueOrDefault(book.Id),
			BookPrice = (decimal)book.Price,
			BookTitle = book.Title
		})?.ToList() ?? new List<ShopCartItemModel>();
	}
}
