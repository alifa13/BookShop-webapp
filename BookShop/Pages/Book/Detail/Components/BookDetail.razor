@page "/books/{BookId}"

@using BookShop.ApiCaller.Model;
@using BookShop.Services;
@using BookShop.Utility;

@inject ShopCartService shopCartService;
@inject UserLoginStateContainer UserLoginStateContainer;
@inject ToastHelper ToastHelper;

<section class="content-inner-1">
    <div class="container">
        <div class="row book-grid-row style-4 m-b60">
            <div class="col">
                <div class="dz-box">
                    <div class="dz-media">
                        <img src="images/books/book16.png" alt="book">
                    </div>
                    <div class="dz-content">
                        <div class="dz-header">
                            <h3 class="title">@(book?.Title ?? string.Empty)</h3>
                            @* <div class="shop-item-rating">
                            <div class="d-lg-flex d-sm-inline-flex d-flex align-items-center">
                            <ul class="dz-rating">
                            <li><i class="flaticon-star text-yellow"></i></li>
                            <li><i class="flaticon-star text-yellow"></i></li>
                            <li><i class="flaticon-star text-yellow"></i></li>
                            <li><i class="flaticon-star text-yellow"></i></li>
                            <li><i class="flaticon-star text-muted"></i></li>
                            </ul>
                            <h6 class="m-b0">4.0</h6>
                            </div>
                            <div class="social-area">
                            <ul class="dz-social-icon style-3">
                            <li><a href="https://www.facebook.com/dexignzone" target="_blank"><i class="fa-brands fa-facebook-f"></i></a></li>
                            <li><a href="https://twitter.com/dexignzones" target="_blank"><i class="fa-brands fa-twitter"></i></a></li>
                            <li><a href="https://www.whatsapp.com/" target="_blank"><i class="fa-brands fa-whatsapp"></i></a></li>
                            <li><a href="https://www.google.com/intl/en-GB/gmail/about/" target="_blank"><i class="fa-solid fa-envelope"></i></a></li>
                            </ul>
                            </div>
                            </div> *@
                        </div>
                        <div class="dz-body">
                            <div class="book-detail">
                                <ul class="book-info">
                                    <li>
                                        <div class="writer-info">
                                            <div>
                                                <span>نویسندگان</span>
                                                @(string.Join(",", bookAuthors.Select(x => x.Name).ToList()))
                                            </div>
                                        </div>
                                    </li>
                                    <li>
                                        <span>ناشر</span>
                                        @(book?.PublisherTitle ?? string.Empty)
                                    </li>
                                    @* <li><span>Year</span>2019</li> *@
                                </ul>
                            </div>
                            <p class="text-1">کتاب خوبیه</p>
                            <div class="book-footer">
                                <div class="price">
                                    <h5>@(book?.Price.ToString() ?? string.Empty) ریال</h5>
                                    @* <p class="p-lr10"></p> *@
                                </div>
                                <div class="product-num">
                                    <a style="margin-right: 15px;" @onclick="() => AddToCart(book?.Id ?? 0)" class="btn btn-primary btnhover btnhover2"><span>افزودن به سبد خرید</span><i class="flaticon-shopping-cart-1"></i></a>
                                    <div class="bookmark-btn style-1 d-none d-sm-block">
                                        <input class="form-check-input" type="checkbox" id="flexCheckDefault1">
                                        <label class="form-check-label" for="flexCheckDefault1">
                                            <i class="flaticon-heart"></i>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-xl-8">
                <div class="product-description tabs-site-button">
                    <ul class="nav nav-tabs">
                        <li><a data-bs-toggle="tab" class="active">جزئیات محصول</a></li>
                    </ul>
                    <div class="tab-content">
                        <div id="graphic-design-1" class="tab-pane show active">
                            <table class="table border book-overview">
                                <tr>
                                    <th>عنوان کتاب</th>
                                    <td>@(book?.Title ?? string.Empty)</td>
                                </tr>
                                <tr>
                                    <th>نویسندگان</th>
                                    <td>@(string.Join(",", bookAuthors.Select(x => x.Name).ToList()))</td>
                                </tr>
                                <tr>
                                    <th>شابک</th>
                                    <td>@(book?.Isbn ?? string.Empty)</td>
                                </tr>
                                <tr>
                                    <th>تعداد صفحه</th>
                                    <td>@(book?.PageNumbers.ToString() ?? string.Empty)</td>
                                </tr>
                                <tr>
                                    <th>ناشر</th>
                                    <td>@(book?.PublisherTitle ?? string.Empty)</td>
                                </tr>
                                <tr>
                                    <th>مترجمان</th>
                                    <td>@(string.Join(",", bookTranslators.Select(x => x.Name).ToList()))</td>
                                </tr>
                                <tr class="tags">
                                    <th>برچسب ها</th>
                                    <td>
                                        @foreach (var group in bookGroups)
                                        {
                                            <Badge Color="Color.Primary">@(group.Title)</Badge>
                                        }
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-4 mt-5 mt-xl-0">
                <div class="widget">
                    <h4 class="widget-title">کتاب های مرتبط</h4>
                    <div class="row">
                        @foreach (var book in relatedBooks)
                        {
                            <div class="col-xl-12 col-lg-6">
                                <div class="dz-shop-card style-5">
                                    <div class="dz-media">
                                        <img src="images/books/grid/book15.jpg" alt="">
                                    </div>
                                    <div class="dz-content">
                                        <h5 class="subtitle">@(book.Title)</h5>
                                        <ul class="dz-tags">
                                            @foreach (var groupId in book.GroupsIds)
                                            {
                                                @if (groupId == book.GroupsIds!.Last())
                                                {
                                                    <li><a>@(groups.FirstOrDefault(x => x.Id == groupId)?.Title ?? string.Empty)</a></li>
                                                }
                                                else
                                                {
                                                    <li><a>@(groups.FirstOrDefault(x => x.Id == groupId)?.Title ?? string.Empty) ,</a></li>
                                                }
                                            }

                                        </ul>
                                        <div class="price">
                                            <span class="price-num">@(book?.Price.ToString())</span>
                                            @* <del>$98.4</del> *@
                                        </div>
                                        <a @onclick="() => AddToCart(book?.Id)" class="btn btn-outline-primary btn-sm btnhover btnhover2"><i class="flaticon-shopping-cart-1 me-2"></i> افزودن به سبد خرید</a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    [Parameter]
    public string? BookId { get; set; }

    ApiCaller.Model.BookDTO? book;
    List<ApiCaller.Model.BookDTO> relatedBooks = new List<BookDTO>();
    List<GroupDTO> groups = new List<GroupDTO>();
    List<AuthorDTO> authors = new List<AuthorDTO>();
    List<TranslatorDTO> translators = new List<TranslatorDTO>();
    List<GroupDTO> bookGroups = new List<GroupDTO>();
    List<AuthorDTO> bookAuthors = new List<AuthorDTO>();
    List<TranslatorDTO> bookTranslators = new List<TranslatorDTO>();

    protected override async Task OnParametersSetAsync()
    {
        await LoadBook();
        await base.OnParametersSetAsync();
    }

    private async Task LoadBook()
    {
        if (int.TryParse(BookId, out int bookId))
        {
            var response = await ApiCallService.BookApi.ApiBookGetIdGetAsync(bookId);
            if (!(response?.IsSuccess ?? false))
                return;

            book = response.ResponseDTO;

            await LoadBookGroups();
            await LoadBookAuthors();
            await LoadBookTranslators();
            await LoadRelatedBooks();
        }
    }

    private async Task LoadBookGroups()
    {
        if (!groups.Any())
        {
            var response = await ApiCallService.GroupApi.ApiGroupGetGetAsync();
            if (!(response?.IsSuccess ?? false))
                return;

            groups = response.ResponseDTOList ?? new List<GroupDTO>();
        }

        bookGroups = groups
                         .Where(g => book != null && book.GroupsIds.Contains(g.Id))
                         .ToList();
    }

    private async Task LoadBookAuthors()
    {
        if (!authors.Any())
        {
            var response = await ApiCallService.AuthorApi.ApiAuthorGetGetAsync();
            if (!(response?.IsSuccess ?? false))
                return;

            authors = response.ResponseDTOList ?? new List<AuthorDTO>();
        }

        bookAuthors = authors
                         .Where(a => book?.AuthorIds != null && book.AuthorIds.Any(ba => ba == a.Id))
                         .ToList();
    }

    private async Task LoadBookTranslators()
    {
        if (!translators.Any())
        {
            var response = await ApiCallService.TranslatorApi.ApiTranslatorGetGetAsync();
            if (!(response?.IsSuccess ?? false))
                return;

            translators = response.ResponseDTOList ?? new List<TranslatorDTO>();
        }

        bookTranslators = translators
                         .Where(t => book != null && book.TranslatorIds.Contains(t.Id))
                         .ToList();
    }

    private async Task LoadRelatedBooks()
    {
        if (!int.TryParse(BookId, out int bookId))
            return;

        var response = await ApiCallService.BookApi.ApiBookReportPostAsync(new BookReportFilterDTOApiRequest
            {
                RequestDTO = new BookReportFilterDTO
                {
                    GroupIDs = bookGroups.Select(bg => bg.Id).ToList()
                }
            });

        if (!(response?.IsSuccess ?? false))
            return;

        relatedBooks = response.ResponseDTO?.ResultList?.Where(x => x.Id != bookId)?.ToList() ?? new List<BookDTO>();
    }

    private EventCallback AddToCart(int? bookId)
    {
        if (bookId is not null && bookId > 0)
            shopCartService.AddToCart(bookId.Value);

        return new EventCallback();
    }

    private async Task AddToWishlist(int? bookId)
    {
        var customer = UserLoginStateContainer.Customer;
        if (customer is null)
            return;

        if (bookId is null || bookId <= 0)
            return;

        var response = await ApiCallService.CustomerApi.ApiCustomerWishlistPostAsync(new CustomerWishlistDTOApiRequest
            {
                RequestDTO = new CustomerWishlistDTO
                {
                    BookId = bookId.Value,
                    CustomerId = customer.Id
                }
            });

        if (!(response?.IsSuccess ?? false))
        {
            await ToastHelper.Notify("افزودن کتاب به لیست علاقه مندی های شما با خطا مواجه شد", ToastType.Error);
            return;
        }
        else
            await ToastHelper.Notify("کتاب مورد نظر به لیست علاقه مندی های شما اضافه شد", ToastType.Success);
    }
}
