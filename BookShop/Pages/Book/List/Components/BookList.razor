@page "/book/list"
@using BookShop.ApiCaller.Api;
@using BookShop.ApiCaller.Model;
@using BookShop.Services;
@using BookShop.Shared.Models;

@inject IJSRuntime JsRuntime
@inject ShopFilterStateContainer shopFilterStateContainer
@inject ShopCartService shopCartService
@inject IConfiguration Configuration;

@implements IDisposable

@foreach (var book in books)
{
    <div class="col-md-12 col-sm-12">
        <div class="dz-shop-card style-2">
            <div class="dz-media">
                <img src="images/books/grid/book12.jpg" alt="book">
            </div>
            <div class="dz-content">
                <div class="dz-header">
                    <div>
                        <ul class="dz-tags">
                            @foreach (var group in bookGroups)
                            {
                                @if (group.Id == book.GroupsIds.Last())
                                {
                                    <li><a>@(group.Title)</a></li>
                                }
                                else
                                {
                                    <li><a>@(group.Title) ,</a></li>
                                }
                            }
                        </ul>
                        <h4 class="title mb-0"><a href="@($"/books/{book.Id}")">@(book.Title)</a></h4>
                    </div>
                    <div class="price">
                        <span class="price-num text-primary">@(book.Price.ToString()) ریال</span>
                        @* 						<del>$70.00</del>
                    *@
                    </div>
                </div>

                <div class="dz-body">
                    <div class="dz-rating-box">
                        <div>
                            <p class="dz-para">کتاب خوبیه</p>
                        </div>
                        @* <div class="review-num">
                    <h4>4.0</h4>
                    <ul class="dz-rating">
                    <li><i class="flaticon-star text-yellow"></i></li>
                    <li><i class="flaticon-star text-yellow"></i></li>
                    <li><i class="flaticon-star text-yellow"></i></li>
                    <li><i class="flaticon-star text-yellow"></i></li>
                    <li><i class="flaticon-star text-muted"></i></li>
                    </ul>
                    <span><a href="javascript:void(0);"> 235 Reviews</a></span>
                    </div> *@
                    </div>
                    <div class="rate">
                        <ul class="book-info">
                            <li><span>نویسندگان</span>@(string.Join(",", bookAuthors.Where(a => book.AuthorIds.Any(ba => ba == a.Id)).Select(a => a.Name).ToList()))</li>
                            <li><span>ناشر</span>@(book.PublisherTitle)</li>
                            @*                             <li><span>سال نشر</span>2019</li>
                        *@
                        </ul>
                        <div class="d-flex">
                            <a @onclick="() => AddToCart(book.Id)" class="btn btn-secondary btnhover btnhover2"><i class="flaticon-shopping-cart-1 m-r10"></i> افزودن به سبد خرید</a>
                            <div class="bookmark-btn style-1">
                                <input class="form-check-input" type="checkbox" id="flexCheckDefault1">
                                <label class="form-check-label" for="flexCheckDefault1">
                                    <i class="flaticon-heart"></i>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}


<div class="row page">
    <div class="col-md-6">
        <p class="page-text">نمایش 12 از @(activePageNo)</p>
    </div>
    <div class="col-md-6">
        <Pagination Class="pagination style-1 p-t20">
            <PaginationItem Disabled="@(activePageNo == 1)" Class="page-item" @onclick="() => NavigateToPage((activePageNo - 1).ToString())">
                <PaginationLink>
                    قبل
                </PaginationLink>
            </PaginationItem>
            @for (int i = 0; i < numberOfPages; i++)
            {
                <PaginationItem Active="@(activePageNo == i)" Class="page-item">
                    <PaginationLink Page="@((i).ToString())" Clicked="NavigateToPage">
                        @(i)
                    </PaginationLink>
                </PaginationItem>
            }
            <PaginationItem Disabled="@(activePageNo == numberOfPages)" Class="page-item" @onclick="() => NavigateToPage((activePageNo + 1).ToString())">
                <PaginationLink>
                    بعد
                </PaginationLink>
            </PaginationItem>
        </Pagination>
    </div>
</div>

@code {
    ShopFilterModel filter = new ShopFilterModel();
    List<BookDTO> books = new List<BookDTO>();
    List<GroupDTO> groups = new List<GroupDTO>();
    List<AuthorDTO> authors = new List<AuthorDTO>();
    List<GroupDTO> bookGroups = new List<GroupDTO>();
    List<AuthorDTO> bookAuthors = new List<AuthorDTO>();
    int numberOfPages = 1;
    int activePageNo = 1;

    protected async override Task OnInitializedAsync()
    {
        await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./vendor/bootstrap-select/dist/js/bootstrap-select.min.js");
        await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./vendor/countdown/counter.js");
        await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./vendor/wnumb/wNumb.js");
        await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./vendor/nouislider/nouislider.min.js");
        await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./vendor/swiper/swiper-bundle.min.js");
        await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/custom.js");
        await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/dz.carousel.js");
        await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/dz.ajax.js");
        shopFilterStateContainer.OnStateChange += FilterChanged;


        await base.OnInitializedAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadBooks(1, 12);
        await base.OnParametersSetAsync();
    }

    private async Task LoadBooks(int pageNo, int itemCount)
    {
        var response = await ApiCallService.BookApi.ApiBookReportPostAsync(new ApiCaller.Model.BookReportFilterDTOApiRequest
            {
                RequestDTO = new ApiCaller.Model.BookReportFilterDTO
                {
                    PublisherIDs = filter.PublisherId,
                    FromPrice = filter.FromPrice,
                    ToPrice = filter.ToPrice,
                    GroupIDs = filter.CategoryIds
                },
                PageNumber = pageNo,
                Count = itemCount
            });

        if (response?.IsSuccess ?? false)
        {
            books = response.ResponseDTO?.ResultList ?? new List<BookDTO>();
            numberOfPages = response.ResponseDTO?.NumberOfPages ?? 1;
        }

        await LoadBookGroups();
        await LoadBookAuthors();
    }

    private async Task LoadBookGroups()
    {
        if (!groups.Any())
        {
            var response = await ApiCallService.GroupApi.ApiGroupGetGetAsync();
            if (!(response?.IsSuccess ?? false))
                return;

            groups = response.ResponseDTOList ?? new List<GroupDTO>();
        }

        bookGroups = groups
                         .Where(g => books.SelectMany(b => b.GroupsIds).Distinct().Any(bg => bg == g.Id))
                         .ToList();
    }

    private async Task LoadBookAuthors()
    {
        if (!authors.Any())
        {
            var response = await ApiCallService.AuthorApi.ApiAuthorGetGetAsync();
            if (!(response?.IsSuccess ?? false))
                return;

            authors = response.ResponseDTOList ?? new List<AuthorDTO>();
        }

        bookAuthors = authors
                         .Where(a => books.SelectMany(b => b.AuthorIds).Distinct().Any(ba => ba == a.Id))
                         .ToList();
    }

    private void FilterChanged()
    {
        filter = shopFilterStateContainer.ShopFilter;
    }

    private EventCallback AddToCart(int bookId)
    {
        shopCartService.AddToCart(bookId);

        return new EventCallback();
    }

    private async void NavigateToPage(string pageNo)
    {
        if (int.TryParse(pageNo, out int numberOfPage))
            await LoadBooks(numberOfPage, 12);
    }

    public void Dispose()
    {
        shopFilterStateContainer.OnStateChange -= FilterChanged;
    }
}
