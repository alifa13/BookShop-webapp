@page "/Profile/Orders"
@using BookShop.Services;
@using BookShop.Utility;

@inject CookieHelper CookieHelper;
@inject NavigationManager navManager;
@inject UserLoginStateContainer UserLoginStateContainer;


<div class="shop-bx shop-profile">
    <div class="shop-bx-title clearfix">
        <h5 class="text-uppercase">سفارشات نقدی</h5>
    </div>
    <div style="border:1px solid rgb(222 226 230); border-top-left-radius:0.375rem;border-top-right-radius:0.375rem; padding: 20px">
        <Table FixedHeader FixedHeaderTableHeight="300px">
             <TableHeader ThemeContrast="ThemeContrast.Light">
                 <TableRow>
                     <TableHeaderCell>#</TableHeaderCell>
                     <TableHeaderCell>تاریخ ایجاد</TableHeaderCell>
                     <TableHeaderCell>نام مشتری</TableHeaderCell>
                     <TableHeaderCell>وضعیت</TableHeaderCell>
                     <TableHeaderCell>روش پرداخت</TableHeaderCell>
                     <TableHeaderCell>مبلغ کل (ریال)</TableHeaderCell>
                     <TableHeaderCell></TableHeaderCell>
                 </TableRow>
             </TableHeader>
             <TableBody>
                 @if (!(cashOrders?.Any() ?? false))
                {
                    <h4>اطلاعات سفارش ها یافت نشد</h4>
                }
                else
                {
                    @foreach (var order in cashOrders.Select((value, index) => (value, index)))
                    {
                        <TableRow @key="order.value.Id">
                            <TableRowHeader>@(order.index + 1)</TableRowHeader>
                                <TableRowCell>@order.value.CreateDate.ToPersianCalender()</TableRowCell>
                                <TableRowCell>@order.value.CustomerFullName</TableRowCell>
                                <TableRowCell>@order.value.StatusStr</TableRowCell>
                                <TableRowCell>@(order.value.IsInstallment ? "اقساطی" : "نقدی")</TableRowCell>
                                <TableRowCell>@order.value.TotalAmount.ToPriceFormat()</TableRowCell>
                                <TableRowCell>
                                    <Dropdown>
                                        <DropdownToggle Color="Color.Primary">
                                            عملیات
                                        </DropdownToggle>
                                        <DropdownMenu>
                                            <DropdownItem Clicked="() => ClickOrderViewButton(order.value.Id)">مشاهده</DropdownItem>
                                            <DropdownDivider />
                                            @if (order.value.Status == ApiCaller.Model.OrderStatus.AwaitingPayment)
                                            {
                                                <DropdownItem Clicked="() => TestGuaranteeFile(order.value.Id)">پرداخت</DropdownItem>
                                            }

                                    </DropdownMenu>
                                </Dropdown>
                            </TableRowCell>
                        </TableRow>
                    }
                }
            </TableBody>
        </Table>
    </div>
    <div class="shop-bx-title clearfix">
        <h5 class="text-uppercase">سفارشات اقساطی</h5>
    </div>
    <div style="border:1px solid rgb(222 226 230); border-top-left-radius:0.375rem;border-top-right-radius:0.375rem; padding: 20px">
        <Table FixedHeader FixedHeaderTableHeight="300px">
             <TableHeader ThemeContrast="ThemeContrast.Light">
                 <TableRow>
                     <TableHeaderCell>#</TableHeaderCell>
                     <TableHeaderCell>تاریخ ایجاد</TableHeaderCell>
                     <TableHeaderCell>نام مشتری</TableHeaderCell>
                     <TableHeaderCell>وضعیت</TableHeaderCell>
                     <TableHeaderCell>روش پرداخت</TableHeaderCell>
                     <TableHeaderCell>مبلغ کل (ریال)</TableHeaderCell>
                     <TableHeaderCell></TableHeaderCell>
                 </TableRow>
             </TableHeader>
             <TableBody>
                 @if (!(installmentOrders?.Any() ?? false))
                {
                    <h4>اطلاعات سفارش ها یافت نشد</h4>
                }
                else
                {
                    @foreach (var order in installmentOrders.Select((value, index) => (value, index)))
                    {
                        <TableRow @key="order.value.Id">
                            <TableRowHeader>@(order.index + 1)</TableRowHeader>
                                <TableRowCell>@order.value.CreateDate.ToPersianCalender()</TableRowCell>
                                <TableRowCell>@order.value.CustomerFullName</TableRowCell>
                                <TableRowCell>@order.value.StatusStr</TableRowCell>
                                <TableRowCell>@(order.value.IsInstallment ? "اقساطی" : "نقدی")</TableRowCell>
                                <TableRowCell>@order.value.TotalAmount</TableRowCell>
                                <TableRowCell>
                                    <Dropdown>
                                        <DropdownToggle Color="Color.Primary">
                                            عملیات
                                        </DropdownToggle>
                                        <DropdownMenu>
                                            <DropdownItem>مشاهده</DropdownItem>
                                            <DropdownDivider />
                                            @if (order.value.Status == ApiCaller.Model.OrderStatus.GetGuarantee)
                                            {
                                                <DropdownItem Clicked="() => TestGuaranteeFile(order.value.Id)">دریافت ضمانت نامه</DropdownItem>
                                            }
                                    </DropdownMenu>
                                </Dropdown>
                            </TableRowCell>
                        </TableRow>
                    }
                }
            </TableBody>
        </Table>
    </div>
</div>


@code {
    [Inject] public IModalService? ModalService { get; set; }

    List<ApiCaller.Model.OrderDTO> cashOrders = new List<ApiCaller.Model.OrderDTO>();
    List<ApiCaller.Model.OrderDTO> installmentOrders = new List<ApiCaller.Model.OrderDTO>();

    protected override async Task OnParametersSetAsync()
    {
        await LoadOrders();

        await base.OnParametersSetAsync();
    }

    private async Task LoadOrders()
    {
        int customerId = UserLoginStateContainer.Customer?.Id ?? 0;
        if (customerId <= 0)
            return;

        await ApiCallService.OrderApi.ConfigureWebToken();
        var response = await ApiCallService.OrderApi.ApiOrderGetCustomerOrdersCustomerIdGetAsync(customerId);

        if (!(response?.IsSuccess ?? false))
            return;

        cashOrders = response.ResponseDTOList?.Where(x => !x.IsInstallment)?.ToList() ?? new List<ApiCaller.Model.OrderDTO>();
        installmentOrders = response.ResponseDTOList?.Except(cashOrders)?.ToList() ?? new List<ApiCaller.Model.OrderDTO>();
    }

    private async Task TestGuaranteeFile(int orderId)
    {
        await ModalService.Show<UploadOrderGuaranteeModal>(x => x.Add("OrderId", orderId), new ModalInstanceOptions
            {
                Size = ModalSize.Large,
                Centered = true,
                UseModalStructure = false,
            });
    }

    private void ClickOrderViewButton(int orderId)
    {
        navManager.NavigateTo($"/Profile/Orders/{orderId}", false);
    }
}
