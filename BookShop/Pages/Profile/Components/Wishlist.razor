@page "/Profile/Wishlist"
@using BookShop.ApiCaller.Model;
@using BookShop.Services;
@using BookShop.Utility;

@inject UserLoginStateContainer UserLoginStateContainer;
@inject ToastHelper ToastHelper;

<div class="shop-bx shop-profile">
    <div class="shop-bx-title clearfix">
        <h5 class="text-uppercase">علاقه مندی ها</h5>
    </div>
    <div style="border:1px solid rgb(222 226 230); border-top-left-radius:0.375rem;border-top-right-radius:0.375rem; padding: 20px">
        <Table FixedHeader FixedHeaderTableHeight="300px">
             <TableHeader ThemeContrast="ThemeContrast.Light">
                 <TableRow>
                     <TableHeaderCell>عنوان کتاب</TableHeaderCell>
                     <TableHeaderCell>ناشر</TableHeaderCell>
                     <TableHeaderCell>نویسنده</TableHeaderCell>
                     <TableHeaderCell>قیمت (ریال)</TableHeaderCell>
                     <TableHeaderCell></TableHeaderCell>
                 </TableRow>
             </TableHeader>
             <TableBody>
                 @foreach (var item in wishList)
                {
                    <TableRow @key="item.Id">
                        <TableRowCell>@(books.FirstOrDefault(x => x.Id == item.BookId)?.Title ?? string.Empty)</TableRowCell>
                            <TableRowCell>@(books.FirstOrDefault(x => x.Id == item.BookId)?.PublisherTitle ?? string.Empty)</TableRowCell>
                            <TableRowCell>@(string.Join(",", bookAuthors.Select(ba => ba.Name).ToList()))</TableRowCell>
                            <TableRowCell>@(books.FirstOrDefault(x => x.Id == item.BookId)?.Price.ToString() ?? string.Empty)</TableRowCell>
                            <TableRowCell>
                                <a @onclick="() => DeleteWishitemButtonClick(item.Id)" class="ti-close"></a>
                            </TableRowCell>
                        </TableRow>
                }
            </TableBody>
        </Table>
    </div>
</div>

@code {
    [Inject] public IModalService? ModalService { get; set; }

    List<CustomerWishlistDTO> wishList = new List<CustomerWishlistDTO>();
    List<BookDTO> books = new List<BookDTO>();
    List<AuthorDTO> authors = new List<AuthorDTO>();
    List<AuthorDTO> bookAuthors = new List<AuthorDTO>();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await LoadWishlist();

        await base.OnAfterRenderAsync(firstRender);
    }
    private async Task LoadWishlist()
    {
        await ApiCallService.CustomerApi.ConfigureWebToken();
        var customerGetResponse = await ApiCallService.CustomerApi.ApiCustomerGetPostAsync(new ApiRequest { Id = UserLoginStateContainer.UserId });
        if (!(customerGetResponse?.IsSuccess ?? false))
            return;

        await ApiCallService.CustomerApi.ConfigureWebToken();
        var wishlistGetResponse = await ApiCallService.CustomerApi.ApiCustomerCustomerIdWishlistGetAsync(customerGetResponse.ResponseDTO.Id);
        if (!(wishlistGetResponse?.IsSuccess ?? false))
            return;

        wishList = wishlistGetResponse.ResponseDTOList ?? new List<CustomerWishlistDTO>();

        await LoadWishlistBooks();
    }

    private async Task LoadWishlistBooks()
    {
        var bookReportResponse = await ApiCallService.BookApi.ApiBookReportPostAsync(new BookReportFilterDTOApiRequest
            {
                RequestDTO = new BookReportFilterDTO
                {
                    BookIDs = wishList.Select(x => x.BookId).ToList()
                }
            });

        if (!(bookReportResponse?.IsSuccess ?? false))
            return;

        books = bookReportResponse.ResponseDTO?.ResultList ?? new List<BookDTO>();

        await LoadBookAuthors();
    }

    private async Task LoadBookAuthors()
    {
        if (!authors.Any())
        {
            var response = await ApiCallService.AuthorApi.ApiAuthorGetGetAsync();
            if (!(response?.IsSuccess ?? false))
                return;

            authors = response.ResponseDTOList ?? new List<AuthorDTO>();
        }

        bookAuthors = authors
                         .Where(a => books.SelectMany(b => b.AuthorIds).Distinct().Any(ba => ba == a.Id))
                         .ToList();
    }

    private async Task DeleteWishitemButtonClick(int id)
    {
        if (ModalService is null)
            return;

        var wishItem = wishList.FirstOrDefault(x => x.Id == id);
        var bookWishItem = books.FirstOrDefault(b => b.Id == wishItem?.BookId);

        await ModalService.Show<BaseDeleteItemModal>(x =>
        {
            x.Add(x => x.Title, $"حذف {bookWishItem?.Title ?? string.Empty} از کتاب های مورد علاقه شما");
            x.Add(x => x.Message, "آیا مایل به حذف این کتاب از کتاب های مورد علاقه شما هستید ؟");
            x.Add(x => x.DeletedItemId, id);
            x.Add(x => x.OnSuccess, DeleteWishItem);
        }, new ModalInstanceOptions
            {
                UseModalStructure = false,
            });
    }

    private async Task DeleteWishItem(int wishItemId)
    {
        await ApiCallService.CustomerApi.ConfigureWebToken();
        var response = await ApiCallService.CustomerApi.ApiCustomerWishlistIdDeleteAsync(wishItemId);
        if (!(response?.IsSuccess ?? false))
            await ToastHelper.Notify("حذف کتاب مورد نظر با خطا مواجه شد", ToastType.Error);
        else
            await ToastHelper.Notify("کتاب مورد نظر با موفقیت حذف شد", ToastType.Success);
    }
}
