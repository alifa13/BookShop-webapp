                 @for (int i = 1; i <= 50; ++i)
                {
                    var index = i.ToString();

                    <TableRow @key="@index">
                        <TableRowHeader>@index</TableRowHeader>
                        <TableRowCell>Column content</TableRowCell>
                        <TableRowCell>Column content</TableRowCell>
                        <TableRowCell>
                            <a onclick="@DeleteWishitemButtonClick" class="ti-close"></a>
