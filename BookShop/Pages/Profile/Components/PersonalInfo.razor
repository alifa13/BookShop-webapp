@page "/Profile/PersonalInfo"

@using BookShop.ApiCaller.Api;
@using BookShop.Utility;

@inject ToastHelper ToastHelper;
@inject NavigationManager navManager;
@inject IConfiguration Configuration;

<div class="shop-bx shop-profile">
	<div class="shop-bx-title clearfix">
		<h5 class="text-uppercase">اطلاعات کاربری</h5>
	</div>
	<form>
		<div class="row m-b30">
			<div class="col-lg-6 col-md-6">
				<div class="mb-3">
					<Field>
						<FieldLabel Class="label-title">
							نام
						</FieldLabel>
						<FieldBody>
							<TextEdit @bind-Text="@(customerRegisterDTO.Customer.FirstName)" Role="TextRole.Text" />
						</FieldBody>
					</Field>
				</div>
			</div>
			<div class="col-lg-6 col-md-6">
				<div class="mb-3">
					<Field>
						<FieldLabel Class="label-title">
							نام خانوادگی
						</FieldLabel>
						<FieldBody>
							<TextEdit @bind-Text="@(customerRegisterDTO.Customer.LastName)" Role="TextRole.Text" />
						</FieldBody>
					</Field>
				</div>
			</div>
			<div class="col-lg-6 col-md-6">
				<div class="mb-3">
					<Field>
						<FieldLabel Class="label-title">
							شماره همراه *
						</FieldLabel>
						<FieldBody>
							<TextEdit @bind-Text="@(customerRegisterDTO.Customer.Mobile)" Placeholder="09123456789" Pattern="[0-9]{11}" Role="TextRole.Text" />
						</FieldBody>
					</Field>
				</div>
			</div>
			<div class="col-lg-6 col-md-6">
				<div class="mb-3">
					<Field>
						<FieldLabel Class="label-title">
							تلفن ثابت *
						</FieldLabel>
						<FieldBody>
							<TextEdit @bind-Text="@(customerRegisterDTO.Customer.Tel)" Placeholder="02511111111" Pattern="[0-9]{11}" Role="TextRole.Text" />
						</FieldBody>
					</Field>
				</div>
			</div>
			<div class="col-lg-6 col-md-6">
				<div class="mb-3">
					<Field>
						<FieldLabel Class="label-title">
							پست الکترونیک
						</FieldLabel>
						<FieldBody>
							<TextEdit @bind-Text="@(customerRegisterDTO.Customer.Email)" Role="TextRole.Email" />
						</FieldBody>
					</Field>
				</div>
			</div>
			<div class="col-lg-6 col-md-6">
				<div class="mb-4">
					<Field>
						<FieldLabel Class="label-title">
							کد ملی
						</FieldLabel>
						<FieldBody>
							<TextEdit @bind-Text="@(customerRegisterDTO.Customer.NationalCode)" Pattern="[0-9]{10}" Role="TextRole.Text" />
						</FieldBody>
					</Field>
				</div>
			</div>
			<div class="col-lg-6 col-md-6">
				<div class="mb-4">
					<Field>
						<FieldLabel Class="label-title">
							معرف
						</FieldLabel>
						<FieldBody>
							<TextEdit @bind-Text="@(customerRegisterDTO.Customer.Contact)" Role="TextRole.Text" />
						</FieldBody>
					</Field>
				</div>
			</div>
		</div>

		<Button Clicked="SaveButtonClick" class="btn btn-primary btnhover">ذخیره تغییرات</Button>
	</form>
</div>

@code {
	ICustomerApi _CustomerApi = null;
	ApiCaller.Model.CustomerRegisterDTO customerRegisterDTO = new ApiCaller.Model.CustomerRegisterDTO()
		{
			Customer = new ApiCaller.Model.CustomerDTO()
		};

	private async void SaveButtonClick()
	{
		_CustomerApi = new CustomerApi(Configuration["ApiBaseAddress"]);

		var response = await _CustomerApi.ApiCustomerRegisterPostAsync(new ApiCaller.Model.CustomerRegisterDTOApiRequest
			{
				RequestDTO = customerRegisterDTO
			});

		if (response?.IsSuccess ?? false)
		{
			if (response.ResponseDTO is null)
			{
				await ToastHelper.Notify("خطای نامشخص هنگام ذخیره تغییرات", ToastType.Error);
				return;
			}

			await ToastHelper.Notify("ذخیره تغییرات با موفقیت انجام شد", ToastType.Success);
		}
		else
			await ToastHelper.Notify(!string.IsNullOrWhiteSpace(response?.Message) ? response.Message : "خطای نامشخص هنگام ذخیره تغییرات", ToastType.Error);
	}
}
