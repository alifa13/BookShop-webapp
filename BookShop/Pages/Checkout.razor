@page "/Checkout"
@using BookShop.Services;
@using BookShop.Utility;

@inject CookieHelper CookieHelper;

<div class="page-content">
    <!-- inner page banner -->
    <Banner Title="تایید نهایی" PrePageTitle="سبد خرید" PrePageRoute="/ShopCart" />
    <!-- inner page banner End-->
    <!-- contact area -->
    <section class="content-inner-1">
        <!-- Product -->
        <div class="container">
            <form class="shop-form">
                <div class="row">
                    <div class="widget">
                        <h4 class="widget-title">آدرس مقصد</h4>
                        <RadioGroup TValue="int" Name="CustomerAddresses">
                            @if (customerAddress?.Any() ?? false)
                            {
                                @foreach (var address in customerAddress.Select((value, index) => new { index, value }))
                                {
                                    <Radio Value="address.index + 1">
                                        <div class="col-lg-12 col-md-12">
                                            <div class="content-box style-1 m-b30">
                                                <div class="dz-info">
                                                    <h4 class="title">@($"آدرس {address.index + 1}")</h4>
                                                    <p>@($"{address.value.Province} - {address.value.City} - {address.value.Street} - {address.value.Alley} - {address.value.Plaque} - {address.value.Unit}")</p>
                                                    <p>@($"کد پستی : {address.value.PostalCode}")</p>
                                                </div>
                                            </div>
                                        </div>
                                    </Radio>
                                }
                            }
                            else
                            {
                                <Button Margin="Margin.Is3" class="btn btn-primary btnhover me-5">ثبت آدرس جدید</Button>
                            }
                        </RadioGroup>
                    </div>
                </div>
            </form>
            <div class="dz-divider bg-gray-dark text-gray-dark icon-center  my-5"><i class="fa fa-circle bg-white text-gray-dark"></i></div>
            <div class="row">
                <div class="col-lg-6">
                    <div class="widget">
                        <h4 class="widget-title">سفارش</h4>
                        <table class="table-bordered check-tbl">
                            <thead class="text-center">
                                <tr>
                                    <th>IMAGE</th>
                                    <th>PRODUCT NAME</th>
                                    <th>Count</th>
                                    <th>TOTAL</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="product-item-img"><img src="images/books/grid/book3.jpg" alt=""></td>
                                    <td class="product-item-name">Prduct Item 5</td>
                                    <td class="product-price">5</td>
                                    <td class="product-price">$28.00</td>
                                </tr>
                                <tr>
                                    <td class="product-item-img"><img src="images/books/grid/book2.jpg" alt=""></td>
                                    <td class="product-item-name">Prduct Item 4</td>
                                    <td class="product-price">5</td>
                                    <td class="product-price">$36.00</td>
                                </tr>
                                <tr>
                                    <td class="product-item-img"><img src="images/books/grid/book4.jpg" alt=""></td>
                                    <td class="product-item-name">Prduct Item 3</td>
                                    <td class="product-price">5</td>
                                    <td class="product-price">$28.00</td>
                                </tr>
                                <tr>
                                    <td class="product-item-img"><img src="images/books/grid/book5.jpg" alt=""></td>
                                    <td class="product-item-name">Prduct Item 2</td>
                                    <td class="product-price">5</td>
                                    <td class="product-price">$36.00</td>
                                </tr>
                                <tr>
                                    <td class="product-item-img"><img src="images/books/grid/book1.jpg" alt=""></td>
                                    <td class="product-item-name">Prduct Item 1</td>
                                    <td class="product-price">5</td>
                                    <td class="product-price">$28.00</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="col-lg-6">
                    <h4 class="widget-title">روش پرداخت</h4>
                    <Tabs SelectedTab="@selectedTab" SelectedTabChanged="@OnSelectedTabChanged" FullWidth="true">
                        <Items>
                            <Tab Name="Cash">نقدی</Tab>
                            <Tab Name="Installment">اقساطی</Tab>
                        </Items>
                        <Content>
                            <TabPanel Name="Cash">
                                <Field Margin="Margin.Is3" Horizontal>
                                    <FieldLabel ColumnSize="ColumnSize.Is4" Class="label-title">
                                        مبلغ قابل پرداخت
                                    </FieldLabel>
                                    <FieldBody ColumnSize="ColumnSize.Is8">
                                        <TextEdit Disabled @bind-Text="@totalPrice" />
                                     </FieldBody>
                                 </Field>
                             </TabPanel>
                             <TabPanel Name="Installment">
                                 <Field Margin="Margin.Is3" Horizontal>
                                    <FieldLabel ColumnSize="ColumnSize.Is4" Class="label-title">
                                        تعداد اقساط
                                    </FieldLabel>
                                    <FieldBody ColumnSize="ColumnSize.Is8">
                                        <TextEdit @bind-Text="@installmentCount" MaskType="MaskType.RegEx" EditMask="^(\d+(.\d{0,2})?|.?\d{1,2})$" />
                                    </FieldBody>
                                </Field>
                            </TabPanel>
                        </Content>
                    </Tabs>
                    <Button Margin="Margin.Is3" class="btn btn-primary btnhover me-3">ثبت سفارش</Button>
                </div>
            </div>
        </div>
        <!-- Product END -->
    </section>
    <!-- contact area End-->
</div>
@code {
    private string selectedTab = "Cash";
    private string installmentCount = "0";
    private string totalPrice = "4500000 ریال";
    private List<ApiCaller.Model.CustomerAddressDTO>? customerAddress = new List<ApiCaller.Model.CustomerAddressDTO>();

    private Task OnSelectedTabChanged(string name)
    {
        selectedTab = name;

        return Task.CompletedTask;
    }

    private async Task LoadCustomerAddress()
    {
        var userId = Int32.Parse(await CookieHelper.GetCookie("User"));

        var getCustomerResponse = await ApiCallService.CustomerApi.ApiCustomerGetPostAsync(new ApiCaller.Model.ApiRequest
            {
                Id = userId
            });

        if (!(getCustomerResponse?.IsSuccess ?? false) == true)
            return;

        var getAddressResponse = await ApiCallService.CustomerApi.ApiCustomerAddressPostAsync(new ApiCaller.Model.ApiRequest
            {
                Id = getCustomerResponse.ResponseDTO.Id
            });

        if (!(getAddressResponse?.IsSuccess ?? false) == true)
            return;

        customerAddress = getAddressResponse.ResponseDTOList;
    }
}
